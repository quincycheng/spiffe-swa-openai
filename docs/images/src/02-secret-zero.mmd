graph LR
    subgraph BEFORE["❌  before — the secret-zero problem"]
        direction TB
        B1["<b>OPENAI_API_KEY=sk-…</b><br/><i>long-lived bearer token</i>"]
        B2[".env on<br/>every laptop"]
        B3["CI<br/>secrets"]
        B4["a password<br/>manager"]
        B5["someone's<br/>Slack DM"]
        B1 --> B2
        B1 --> B3
        B1 --> B4
        B1 --> B5
        BQ["<i>Who has it? When was it last rotated?<br/>How would you know if it leaked?</i>"]
        B2 -.- BQ
        B5 -.- BQ
    end

    subgraph AFTER["✅  after — attested identity"]
        direction TB
        A1["<b>no key exists anywhere</b>"]
        A2["process calls a unix socket"]
        A3["agent attests the node<br/><i>cryptographic proof, not a password</i>"]
        A4["<b>JWT-SVID</b> — TTL 300s"]
        A5["<b>access_token</b> — TTL 299s"]
        A1 --> A2 --> A3 --> A4 --> A5
        AQ["<i>Nothing to leak, copy, or rotate.</i>"]
        A5 -.- AQ
    end

    B1 ==>|"<b>eliminate</b>"| A1

    style BEFORE fill:#fdeeed,stroke:#c5221f,stroke-width:2px,color:#8a1a17
    style AFTER fill:#edf7f0,stroke:#137333,stroke-width:2px,color:#0b5323

    classDef bad fill:#fff,stroke:#c5221f,stroke-width:2px,color:#111
    classDef good fill:#fff,stroke:#137333,stroke-width:2px,color:#111
    classDef note fill:#fff,stroke:#aaa,stroke-dasharray:4 3,color:#555
    class B1,B2,B3,B4,B5 bad
    class A1,A2,A3,A4,A5 good
    class BQ,AQ note
