# =============================================================================
# Workshop configuration — TEMPLATE.  Copy to `.env` and fill in.
#   cp .env-template .env
# `.env` is gitignored. Never commit it.
# =============================================================================

# --- CyberArk / Idira Secure Workload Access ------------------------------
# Secrets Manager - SaaS tenant. Include the /api suffix; scripts strip it
# when they need the bare host.
#   https://<subdomain>.secretsmgr.cyberark.cloud/api
CONJUR_APPLIANCE_URL=

# CyberArk Identity tenant. This is a DIFFERENT host from the one above:
#   https://<tenant>.id.cyberark.cloud
# If you set the Secrets Manager host here by mistake, scripts/swa-auth.sh
# follows the 302 and recovers, but set it correctly to avoid the round trip.
IDENTITY_TENANT_URL=

# Identity user with the Secrets Manager Admin role.
#   IDSEC_USERNAME: full Identity username, e.g. user@cyberark.cloud.1234
#   IDSEC_SECRET:   that user's PASSWORD — NOT an OAuth client secret.
#                   See docs/01-authentication.md for why this matters.
IDSEC_USERNAME=
IDSEC_SECRET=

# SPIFFE trust domain to create. Any DNS-like name; need not resolve.
SWA_TRUST_DOMAIN=swa-lab.local

# --- OpenAI ---------------------------------------------------------------
# Identifiers, not credentials — no API key appears anywhere in this workshop.
# Both come from the OpenAI console after you create the Workload Identity
# Provider and its service account mapping (see docs/06-openai-federation.md).
OPENAI_IDENTITY_PROVIDER_ID=
OPENAI_SERVICE_ACCOUNT_ID=
